#include <stdio.h>


#define MAX 5 

int stack[MAX];
int top = -1;


int isFull() {
    return top == MAX - 1;
}


int isEmpty() {
    return top == -1;
}


void push(int value) {
    if (isFull()) {
        printf("Stack Overflow! Cannot push %d.\n", value);
    } else {
        top++;
        stack[top] = value;
        printf("Pushed %d onto the stack.\n", value);
    }
}


int pop() {
    if (isEmpty()) {
        printf("Stack Underflow! No element to pop.\n", stdout);
        return -1; 
    } else {
        int poppedValue = stack[top];
        top--;
        return poppedValue;
    }
}


int peek() {
    if (isEmpty()) {
        printf("Stack is empty.\n");
        return -1;
    } else {
        return stack[top];
    }
}


void display() {
    if (isEmpty()) {
        printf("Stack is empty.\n");
    } else {
        printf("Stack elements (from top to bottom): ");
        for (int i = top; i >= 0; i--) {
            printf("%d ", stack[i]);
        }
        printf("\n");
    }
}

int main() {
  
    push(10);
    push(20);
    push(30);
    display();

    printf("Top element is: %d\n", peek());

    printf("Popped element: %d\n", pop());
    display();

    push(40);
    push(50);
    push(60); 
    push(70); 
    display();

    return 0;
}
